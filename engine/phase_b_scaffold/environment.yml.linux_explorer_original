# INTERCEPTA Phase B Layer 5 — Conda Environment
# Pinned versions for reproducibility per Charter v1.2 §1.3 + L4.1 §10.3.
# Use conda-lock to produce fully-resolved lockfile for cross-platform reproducibility.

name: intercepta
channels:
  - conda-forge
  - bioconda
  - nvidia
  - pytorch
  - defaults

dependencies:
  # Python
  - python=3.11

  # Core scientific
  - numpy=1.26
  - scipy=1.13
  - pandas=2.2
  - scikit-learn=1.4
  - statsmodels=0.14
  - h5py=3.11

  # ML
  - pytorch=2.2
  - pytorch-cuda=12.1
  - cudatoolkit=12.1

  # Single-cell
  - anndata=0.10
  - scanpy=1.10

  # Dev tools
  - pytest=8.2
  - pytest-cov=5.0
  - ruff=0.4

  # Pip-only packages
  - pip
  - pip:
    - scvi-tools==1.1.6
    - captum==0.7.0
    - shap==0.45.1
    - hydra-core==1.3.2
    - mlflow==2.13.0
    - hypothesis==6.103.0
    - rdkit==2024.3.3
    # MoLFormer is loaded via HuggingFace transformers; pin transformers
    - transformers==4.41.0
    - tokenizers==0.19.1
    - safetensors==0.4.3
